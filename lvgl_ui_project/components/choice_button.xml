<!-- One option of a segmented control. Add a set_subject_event as a child, and bind
     `selected` to the same subject, e.g. selected="{subject_fan == 2}". -->
<component>
	<api>
		<prop name="text" type="string" default="Option" help="Caption" />
		<prop name="selected" type="bool" default="false" bindable="true"
			help="Fills the button with the accent color" />
	</api>

	<previews>
		<preview name="dark" width="140" height="80" style_bg_color="0x181C24" style_pad_all="16" />
	</previews>

	<view extends="lv_button" height="{touch_min}" flex_grow="1" checked="{selected}"
		style_bg_color-checked="{subject_accent}">
		<style name="style_button" />
		<style name="style_button_pressed" selector="pressed" />
		<style name="style_button_checked" selector="checked" />
		<!-- Dark text on the accent fill -->
		<lv_label text="{text}" align="center"
			style_text_color="{selected ? color_on_accent : color_text}" />
	</view>
</component>
