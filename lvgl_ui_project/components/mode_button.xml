<!-- HVAC mode button: icon over a label. Checked while subject_mode == value. -->
<component>
	<api>
		<prop name="icon" type="image" help="28 px Lucide icon" />
		<prop name="text" type="string" default="Mode" help="Mode name" />
		<prop name="value" type="int" default="0" help="Value written to subject_mode" />
	</api>

	<previews>
		<preview name="dark" width="160" height="110" style_bg_color="0x181C24" style_pad_all="16" />
	</previews>

	<view extends="lv_button" height="100%" flex_grow="1" flex_flow="column"
		checked="{subject_mode == value}"
		style_pad_gap="{space_xs}" style_flex_main_place="center" style_flex_cross_place="center"
		style_flex_track_place="center" style_bg_color-checked="{subject_accent}">
		<style name="style_button" />
		<style name="style_button_pressed" selector="pressed" />
		<style name="style_button_checked" selector="checked" />

		<!-- Dark icon and text on the accent fill -->
		<lv_image src="{icon}"
			style_image_recolor="{subject_mode == value ? color_on_accent : color_text}">
			<style name="style_icon" />
		</lv_image>
		<lv_label text="{text}"
			style_text_color="{subject_mode == value ? color_on_accent : color_text}" />

		<set_subject_event subject="subject_mode" value="{value}" />
	</view>
</component>
