<!-- Square icon button of the nav rail. Add a screen_load_event as a child. -->
<component>
	<api>
		<prop name="icon" type="image" help="28 px Lucide icon" />
		<prop name="active" type="bool" default="false" bindable="true" help="true on the screen this button opens" />
	</api>

	<previews>
		<preview name="dark" width="100" height="100" style_bg_color="0x181C24" style_pad_all="20" />
	</previews>

	<view extends="lv_button" width="{nav_button_size}" height="{nav_button_size}"
		checked="{active}"
		style_bg_opa="0" style_bg_opa-checked="100%" style_bg_color-checked="{subject_accent}">
		<style name="style_button" />
		<style name="style_button_pressed" selector="pressed" />
		<!-- Dark icon on the accent fill, muted otherwise -->
		<lv_image src="{icon}" align="center"
			style_image_recolor="{active ? color_on_accent : color_text_muted}">
			<style name="style_icon" />
		</lv_image>
	</view>
</component>
