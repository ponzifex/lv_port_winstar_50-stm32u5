<!-- Left navigation rail, shared by home, rooms and settings -->
<component>
	<api>
		<!-- active: the screen the rail is on -->
		<variants>
			<variant name="active" options="home rooms settings" default="home" />
		</variants>
	</api>

	<previews>
		<preview name="dark" width="88" height="480" />
	</previews>

	<view extends="lv_obj" width="{nav_rail_width}" height="100%" flex_flow="column"
		scrollable="false"
		style_bg_color="{color_panel}" style_bg_opa="100%" style_radius="0" style_border_width="0"
		style_pad_ver="{space_xl}" style_pad_gap="{space_xl}"
		style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<nav_button icon="icon_house" active="{active == home}">
			<screen_load_event screen="home" anim_type="fade_in" duration="200" />
		</nav_button>
		<nav_button icon="icon_layout_grid" active="{active == rooms}">
			<screen_load_event screen="rooms" anim_type="fade_in" duration="200" />
		</nav_button>
		<nav_button icon="icon_settings" active="{active == settings}">
			<screen_load_event screen="settings" anim_type="fade_in" duration="200" />
		</nav_button>
	</view>
</component>
