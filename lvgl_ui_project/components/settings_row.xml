<!-- A settings card: title and help text on the left, the control on the right.
     Put the control in the "control" slot. -->
<component>
	<api>
		<prop name="title" type="string" default="Setting" help="Setting name" />
		<prop name="subtitle" type="string" default="" help="One line of help under the title" />
		<slot name="control" />
	</api>

	<previews>
		<preview name="dark" width="664" height="120" style_bg_color="0x0E1117"
			style_text_color="0xE9ECF2" style_text_font="font_body" />
	</previews>

	<view extends="lv_obj" width="100%" height="content" flex_flow="row"
		scrollable="false" style_pad_gap="{space_xl}" style_flex_cross_place="center">
		<style name="style_card" />
		<lv_obj flex_grow="1" height="content" flex_flow="column" style_pad_gap="{space_xs}">
			<style name="style_box" />
			<lv_label text="{title}" style_text_font="font_h2" />
			<lv_label text="{subtitle}" hidden="{!subtitle}">
				<style name="style_text_caption" />
			</lv_label>
		</lv_obj>
		<lv_obj name="control" width="content" height="content" flex_flow="row"
			style_pad_gap="{space_sm}" style_flex_cross_place="center">
			<style name="style_box" />
		</lv_obj>
	</view>
</component>
