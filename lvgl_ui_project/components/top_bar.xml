<!-- Screen header: title, then humidity, outdoor temperature and the time -->
<component>
	<api>
		<prop name="title" type="string" default="Home" bindable="true" help="Screen or room name" />
	</api>

	<previews>
		<preview name="dark" width="664" height="48" style_bg_color="0x0E1117"
			style_text_color="0xE9ECF2" style_text_font="font_body" />
	</previews>

	<view extends="lv_obj" width="100%" height="{top_bar_height}" flex_flow="row"
		scrollable="false" style_pad_gap="{space_xl}" style_flex_cross_place="center">
		<style name="style_box" />
		<lv_label text="{title}" flex_grow="1" style_text_font="font_h2" />

		<info_tile icon="icon_droplets">
			<info_tile-value>
				<lv_label text="{subject_humidity . '%'}" />
			</info_tile-value>
		</info_tile>

		<info_tile icon="icon_cloud_sun">
			<info_tile-value>
				<temp_value temp="subject_temp_outdoor" whole="true" />
			</info_tile-value>
		</info_tile>

		<lv_label text="{subject_time}" style_text_font="font_h2" />
	</view>
</component>
